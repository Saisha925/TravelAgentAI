# Required
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: Port overrides (defaults are shown below)
# TRAVEL_MCP_PORT=8001
# WEATHER_MCP_PORT=8002
# MAPS_MCP_PORT=8003
# FLIGHT_AGENT_PORT=9001
# HOTEL_AGENT_PORT=9002
# WEATHER_AGENT_PORT=9003
# API_PORT=8000

# Optional: Frontend URL for CORS
# FRONTEND_URL=http://localhost:3000

# Optional: Gemini Model Overrides (defaults shown below)
# FLASH_MODEL=gemini-3.1-flash-lite
# PRO_MODEL=gemini-3.1-flash-lite
